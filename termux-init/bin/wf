#!/system/bin/sh

set -eu

usage() {
  printf '%s\n' '用法: wf' '打开开发者选项中的无线调试页面。'
}

if [ "$#" -gt 0 ]; then
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
fi

command -v am >/dev/null 2>&1 || {
  printf '[error] 找不到 Android am 命令。\n' >&2
  exit 1
}

if am start -a android.settings.APPLICATION_DEVELOPMENT_SETTINGS \
  --es ':settings:fragment_args_key' toggle_adb_wireless >/dev/null 2>&1; then
  printf '[info] 已打开开发者选项。\n'
  exit 0
fi

am start -a android.settings.DEVELOPMENT_SETTINGS >/dev/null 2>&1 \
  || {
    printf '[error] 无法打开开发者选项。\n' >&2
    exit 1
  }
printf '[info] 已打开开发者选项。\n'

